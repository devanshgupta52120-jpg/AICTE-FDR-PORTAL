# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# =========================================================================
# AICTE FDR Management Portal - Firebase Configuration
# =========================================================================
# Set these environment variables in your deployment environment or .env.local
# Obtain these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app
# NOTE: Never put Google Cloud private service account JSON keys or secret credentials here!

VITE_FIREBASE_API_KEY="AIzaSyYourActualApiKeyFromFirebaseConsole"
VITE_FIREBASE_AUTH_DOMAIN="your-aicte-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-aicte-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-aicte-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"
